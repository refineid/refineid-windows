#!/bin/sh
# RefineID Windows push gate.
#
# Rejects a push whose Cargo.lock does not match the manifests or pins a
# revision that cannot be fetched. It guards consistency, not freshness: a
# lockfile that pins an older refineid-core commit pushes, and moving to a
# newer core is a deliberate change made in its own pull request.
#
# Enable local hooks once per clone with:
#
#     git config core.hooksPath .githooks

set -eu

echo "pre-push: checking that Cargo.lock matches the manifests"

if ! cargo fetch --locked --quiet; then
    echo "pre-push: error: Cargo.lock does not match the manifests, or a pinned revision cannot be fetched."
    echo "pre-push: update the lockfile for the dependency the manifests changed, review the diff, and commit it."
    exit 1
fi

echo "pre-push: ok (Cargo.lock matches the manifests)"
