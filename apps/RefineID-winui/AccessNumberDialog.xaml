<ContentDialog
    x:Class="RefineID.AccessNumberDialog"
    x:Uid="AccessNumberDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Contactless (NFC)"
    CloseButtonText="Cancel"
    mc:Ignorable="d"
>
    <StackPanel MinWidth="320" Spacing="16">
        <!--  The six digits printed on the card, in two groups of three,
              each empty until typed, and the group being typed carries
              the accent line. One text box, kept invisible over the
              groups, takes the typing, so paste and Backspace work as in
              any field, and the sixth digit proves the number on the
              card at once.  -->
        <Grid HorizontalAlignment="Center">
            <StackPanel
                AutomationProperties.AccessibilityView="Raw"
                Orientation="Horizontal"
                Spacing="12"
            >
                <Border
                    x:Name="Group0Line"
                    MinWidth="72"
                    Padding="8,4"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,2"
                >
                    <TextBlock
                        x:Name="Group0"
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="&#160;&#160;&#160;"
                    />
                </Border>
                <Border
                    x:Name="Group1Line"
                    MinWidth="72"
                    Padding="8,4"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,2"
                >
                    <TextBlock
                        x:Name="Group1"
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="&#160;&#160;&#160;"
                    />
                </Border>
            </StackPanel>
            <TextBox
                x:Name="NumberBox"
                x:Uid="AccessNumberBox"
                VerticalAlignment="Stretch"
                AutomationProperties.AutomationId="AccessNumberBox"
                AutomationProperties.Name="Card access number (CAN)"
                InputScope="Number"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                MaxLength="7"
                Opacity="0"
                TextChanged="NumberBox_TextChanged"
            />
        </Grid>

        <TextBlock
            x:Name="StatusText"
            HorizontalAlignment="Center"
            AutomationProperties.AutomationId="StatusText"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="Collapsed"
        />

        <ProgressRing
            x:Name="WaitRing"
            x:Uid="AccessNumberWaitRing"
            Width="28"
            Height="28"
            HorizontalAlignment="Center"
            AutomationProperties.AutomationId="WaitRing"
            AutomationProperties.Name="Proving the access number"
            IsActive="False"
            Visibility="Collapsed"
        />
    </StackPanel>
</ContentDialog>
