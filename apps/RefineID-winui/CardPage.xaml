<Page
    x:Class="RefineID.CardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!--  The content column grows up to its maximum width and stays at
                  the left edge of wider windows.  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="920" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="ActionRoot" Padding="32,20,32,40" Spacing="20">
                    <!--  The outcome of the last operation, and nothing else.  -->
                    <InfoBar
                        x:Name="StatusInfoBar"
                        AutomationProperties.AutomationId="StatusInfoBar"
                        IsClosable="True"
                        IsOpen="False"
                    />

                    <!--  Shown only while more than one reader holds a card.  -->
                    <ComboBox
                        x:Name="ReaderComboBox"
                        x:Uid="ReaderComboBox"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="ReaderComboBox"
                        AutomationProperties.Name="Card reader"
                        Header="Card reader"
                        SelectionChanged="ReaderComboBox_SelectionChanged"
                        Visibility="Collapsed"
                    />

                    <Expander
                        x:Name="NfcExpander"
                        x:Uid="NfcExpander"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="NfcExpander"
                        AutomationProperties.Name="Contactless NFC"
                        Header="Contactless NFC"
                        Visibility="Collapsed"
                    >
                        <StackPanel Padding="0,12,0,4" Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox
                                    x:Name="CanBox"
                                    x:Uid="CanBox"
                                    AutomationProperties.AutomationId="CanBox"
                                    AutomationProperties.Name="Card access number (CAN)"
                                    Header="Card access number (CAN)"
                                    MaxLength="6"
                                    PasswordRevealMode="Peek"
                                />
                                <Button
                                    x:Name="EnableNfcButton"
                                    x:Uid="EnableNfcButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.AutomationId="EnableNfcButton"
                                    AutomationProperties.Name="Enable NFC access"
                                    Click="EnableNfcButton_Click"
                                    Content="Enable NFC access"
                                />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <StackPanel
                        x:Name="ManagementPanel"
                        IsHitTestVisible="False"
                        Opacity="0.6"
                        Spacing="12"
                    >
                        <Expander
                            x:Name="ChangePinExpander"
                            x:Uid="ChangePinExpander"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="ChangePinExpander"
                            AutomationProperties.Name="Change PIN"
                            Header="Change PIN"
                            Visibility="Collapsed"
                        >
                            <StackPanel Padding="0,12,0,4" Spacing="10">
                                <ComboBox
                                    x:Name="ChangeSlotBox"
                                    x:Uid="ChangeSlotBox"
                                    AutomationProperties.AutomationId="ChangeSlotBox"
                                    AutomationProperties.Name="Credential to change"
                                    Header="Credential"
                                    SelectedIndex="0"
                                >
                                    <ComboBoxItem
                                        x:Uid="ChangeSlotPin1Item"
                                        Content="Basic PIN (PIN 1)"
                                    />
                                    <ComboBoxItem
                                        x:Uid="ChangeSlotPin2Item"
                                        Content="Signature PIN (PIN 2)"
                                    />
                                </ComboBox>
                                <PasswordBox
                                    x:Name="CurrentPinBox"
                                    x:Uid="CurrentPinBox"
                                    AutomationProperties.AutomationId="CurrentPinBox"
                                    AutomationProperties.Name="Current PIN"
                                    Header="Current PIN"
                                    MaxLength="12"
                                    PasswordRevealMode="Peek"
                                />
                                <PasswordBox
                                    x:Name="NewPinBox"
                                    AutomationProperties.AutomationId="NewPinBox"
                                    MaxLength="12"
                                    PasswordRevealMode="Peek"
                                />
                                <PasswordBox
                                    x:Name="NewPinConfirmationBox"
                                    AutomationProperties.AutomationId="NewPinConfirmationBox"
                                    MaxLength="12"
                                    PasswordRevealMode="Peek"
                                />
                                <Button
                                    x:Name="ChangePinButton"
                                    x:Uid="ChangePinButton"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="ChangePinButton"
                                    AutomationProperties.Name="Change PIN"
                                    Click="ChangePinButton_Click"
                                    Content="Change PIN"
                                />
                            </StackPanel>
                        </Expander>

                        <Expander
                            x:Name="UnblockPinExpander"
                            x:Uid="UnblockPinExpander"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="UnblockPinExpander"
                            AutomationProperties.Name="Reset PIN (PUK)"
                            Header="Reset PIN (PUK)"
                            Visibility="Collapsed"
                        >
                            <StackPanel Padding="0,12,0,4" Spacing="10">
                                <ComboBox
                                    x:Name="UnblockSlotBox"
                                    x:Uid="UnblockSlotBox"
                                    AutomationProperties.AutomationId="UnblockSlotBox"
                                    AutomationProperties.Name="Credential to reset"
                                    Header="Credential"
                                    SelectedIndex="1"
                                >
                                    <ComboBoxItem
                                        x:Uid="UnblockSlotPin1Item"
                                        Content="Basic PIN (PIN 1)"
                                    />
                                    <ComboBoxItem
                                        x:Uid="UnblockSlotPin2Item"
                                        Content="Signature PIN (PIN 2)"
                                    />
                                </ComboBox>
                                <PasswordBox
                                    x:Name="PukBox"
                                    x:Uid="PukBox"
                                    AutomationProperties.AutomationId="PukBox"
                                    AutomationProperties.Name="Recovery code (PUK)"
                                    Header="Recovery code (PUK)"
                                    MaxLength="12"
                                    PasswordRevealMode="Peek"
                                />
                                <PasswordBox
                                    x:Name="UnblockNewPinBox"
                                    AutomationProperties.AutomationId="UnblockNewPinBox"
                                    MaxLength="12"
                                    PasswordRevealMode="Peek"
                                />
                                <PasswordBox
                                    x:Name="UnblockConfirmationBox"
                                    AutomationProperties.AutomationId="UnblockConfirmationBox"
                                    MaxLength="12"
                                    PasswordRevealMode="Peek"
                                />
                                <Button
                                    x:Name="ResetPinButton"
                                    x:Uid="ResetPinButton"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="ResetPinButton"
                                    AutomationProperties.Name="Reset PIN"
                                    Click="UnblockPinButton_Click"
                                    Content="Reset PIN"
                                />
                            </StackPanel>
                        </Expander>

                        <!--  A plain section, not a fold: for a card that waits
                              for its activation it is the whole page. It and
                              the sections above appear only from an inspected
                              card, which also names the heading.  -->
                        <StackPanel
                            x:Name="ActivationPanel"
                            x:Uid="ActivationPanel"
                            Padding="16,12,16,16"
                            AutomationProperties.AutomationId="ActivationPanel"
                            Spacing="10"
                            Visibility="Collapsed"
                        >
                            <TextBlock
                                x:Name="ActivationHeading"
                                x:Uid="ActivationHeading"
                                Margin="0,0,0,10"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                            />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox
                                    x:Name="ActivationCodeBox"
                                    x:Uid="ActivationCodeBox"
                                    AutomationProperties.AutomationId="ActivationCodeBox"
                                    AutomationProperties.Name="Activation code from letter"
                                    Header="Activation code from letter"
                                    MaxLength="8"
                                    PasswordRevealMode="Peek"
                                    PasswordChanged="ActivationEntry_Changed"
                                />
                                <FontIcon
                                    x:Name="ActivationCodeBoxMark"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.AutomationId="ActivationCodeBoxMark"
                                    Visibility="Collapsed"
                                />
                            </Grid>
                            <!--  A PIN and its repeat stand as one thing, apart from the next.  -->
                            <StackPanel x:Name="ActivationPin1Group" Margin="0,10,0,0" Spacing="10">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox
                                        x:Name="ActivationPin1Box"
                                        x:Uid="ActivationPin1Box"
                                        AutomationProperties.AutomationId="ActivationPin1Box"
                                        AutomationProperties.Name="New basic PIN 1"
                                        Header="New basic PIN 1"
                                        MaxLength="12"
                                        PasswordRevealMode="Peek"
                                        PasswordChanged="ActivationEntry_Changed"
                                    />
                                    <FontIcon
                                        x:Name="ActivationPin1BoxMark"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.AutomationId="ActivationPin1BoxMark"
                                        Visibility="Collapsed"
                                    />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox
                                        x:Name="ActivationPin1ConfirmationBox"
                                        x:Uid="ActivationPin1ConfirmationBox"
                                        AutomationProperties.AutomationId="ActivationPin1ConfirmationBox"
                                        AutomationProperties.Name="Repeat PIN 1"
                                        Header="Repeat PIN 1"
                                        MaxLength="12"
                                        PasswordRevealMode="Peek"
                                        PasswordChanged="ActivationEntry_Changed"
                                    />
                                    <FontIcon
                                        x:Name="ActivationPin1ConfirmationBoxMark"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.AutomationId="ActivationPin1ConfirmationBoxMark"
                                        Visibility="Collapsed"
                                    />
                                </Grid>
                            </StackPanel>
                            <!--  A PIN and its repeat stand as one thing, apart from the next.  -->
                            <StackPanel x:Name="ActivationPin2Group" Margin="0,10,0,0" Spacing="10">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox
                                        x:Name="ActivationPin2Box"
                                        x:Uid="ActivationPin2Box"
                                        AutomationProperties.AutomationId="ActivationPin2Box"
                                        AutomationProperties.Name="New signature PIN 2"
                                        Header="New signature PIN 2"
                                        MaxLength="12"
                                        PasswordRevealMode="Peek"
                                        PasswordChanged="ActivationEntry_Changed"
                                    />
                                    <FontIcon
                                        x:Name="ActivationPin2BoxMark"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.AutomationId="ActivationPin2BoxMark"
                                        Visibility="Collapsed"
                                    />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox
                                        x:Name="ActivationPin2ConfirmationBox"
                                        x:Uid="ActivationPin2ConfirmationBox"
                                        AutomationProperties.AutomationId="ActivationPin2ConfirmationBox"
                                        AutomationProperties.Name="Repeat PIN 2"
                                        Header="Repeat PIN 2"
                                        MaxLength="12"
                                        PasswordRevealMode="Peek"
                                        PasswordChanged="ActivationEntry_Changed"
                                    />
                                    <FontIcon
                                        x:Name="ActivationPin2ConfirmationBoxMark"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.AutomationId="ActivationPin2ConfirmationBoxMark"
                                        Visibility="Collapsed"
                                    />
                                </Grid>
                            </StackPanel>
                            <!--  The label comes from Strings/<language>/Resources.resw;
                                  the English here is the fallback.  -->
                            <Button
                                x:Name="ActivateButton"
                                IsEnabled="False"
                                x:Uid="ActivateButton"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="ActivateButton"
                                AutomationProperties.Name="Activate identity card"
                                Click="ActivateButton_Click"
                                Content="Activate identity card"
                            />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border
            x:Name="BusyOverlay"
            Background="#66000000"
            IsHitTestVisible="True"
            Visibility="Collapsed"
        >
            <ProgressRing
                x:Uid="CardPageBusyRing"
                Width="48"
                Height="48"
                AutomationProperties.AutomationId="BusyRing"
                AutomationProperties.Name="Working with the card"
                IsActive="True"
            />
        </Border>
    </Grid>
</Page>
