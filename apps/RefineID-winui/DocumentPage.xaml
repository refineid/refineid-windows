<Page
    x:Class="RefineID.DocumentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="920" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="ActionRoot" Padding="32,20,32,40" Spacing="16">
                    <TextBlock
                        x:Name="TitleText"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource TitleTextBlockStyle}"
                    />
                    <InfoBar
                        x:Name="StatusInfoBar"
                        AutomationProperties.AutomationId="StatusInfoBar"
                        IsClosable="True"
                        IsOpen="False"
                    />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="FileBox"
                            x:Uid="FileBox"
                            AutomationProperties.AutomationId="FileBox"
                            AutomationProperties.Name="File"
                            Header="File"
                            IsReadOnly="True"
                        />
                        <Button
                            x:Name="ChooseFileButton"
                            x:Uid="ChooseFileButton"
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            AutomationProperties.AutomationId="ChooseFileButton"
                            AutomationProperties.Name="Choose file"
                            Click="ChooseFileButton_Click"
                            Content="Choose"
                        />
                    </Grid>
                    <StackPanel x:Name="SignPanel" Spacing="12" Visibility="Collapsed">
                        <ComboBox
                            x:Name="FormatBox"
                            x:Uid="FormatBox"
                            AutomationProperties.AutomationId="FormatBox"
                            AutomationProperties.Name="Signature format"
                            Header="Format"
                            SelectedIndex="0"
                        >
                            <ComboBoxItem x:Uid="FormatPdfItem" Content="PDF signature" />
                            <ComboBoxItem x:Uid="FormatAsicEItem" Content="ASiC-E container" />
                        </ComboBox>
                        <PasswordBox
                            x:Name="PinBox"
                            x:Uid="PinBox"
                            AutomationProperties.AutomationId="PinBox"
                            AutomationProperties.Name="Signature PIN (PIN 2)"
                            Header="Signature PIN (PIN 2)"
                            MaxLength="12"
                            PasswordRevealMode="Hidden"
                        />
                        <TextBox
                            x:Name="ReasonBox"
                            x:Uid="ReasonBox"
                            AutomationProperties.AutomationId="ReasonBox"
                            AutomationProperties.Name="Reason"
                            Header="Reason"
                            MaxLength="256"
                        />
                        <Button
                            x:Name="SignButton"
                            x:Uid="SignButton"
                            AutomationProperties.AutomationId="SignButton"
                            AutomationProperties.Name="Sign"
                            Click="SignButton_Click"
                            Content="Sign"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                        />
                    </StackPanel>
                    <Button
                        x:Name="VerifyButton"
                        x:Uid="VerifyButton"
                        AutomationProperties.AutomationId="VerifyButton"
                        AutomationProperties.Name="Verify"
                        Click="VerifyButton_Click"
                        Content="Verify"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="Collapsed"
                    />
                    <TextBlock
                        x:Name="ResultText"
                        AutomationProperties.AutomationId="ResultText"
                        FontFamily="Consolas"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap"
                    />
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <Grid
            x:Name="BusyOverlay"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            IsHitTestVisible="False"
            Visibility="Collapsed"
        >
            <ProgressRing IsActive="True" />
        </Grid>
    </Grid>
</Page>
