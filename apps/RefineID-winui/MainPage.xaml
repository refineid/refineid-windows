<Page
    x:Class="RefineID.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="920"
                Padding="32,20,32,40"
                HorizontalAlignment="Stretch"
                Spacing="24"
            >
                <TextBlock
                    Margin="4,8,0,0"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="RefineID"
                />

                <InfoBar
                    x:Name="StatusInfoBar"
                    AutomationProperties.AutomationId="StatusInfoBar"
                    IsClosable="True"
                    IsOpen="False"
                />

                <!--  Document  -->
                <StackPanel Spacing="4">
                    <TextBlock
                        Margin="4,0,0,0"
                        AutomationProperties.HeadingLevel="Level2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Document"
                    />
                    <controls:SettingsCard
                        x:Name="VerifyCard"
                        AutomationProperties.AutomationId="VerifyCard"
                        AutomationProperties.HelpText="Verify a signed document using the card"
                        AutomationProperties.Name="Verify document"
                        Header="Verify"
                        IsClickEnabled="True"
                    >
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE73E;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        x:Name="SignCard"
                        AutomationProperties.AutomationId="SignCard"
                        AutomationProperties.HelpText="Sign a document with the card"
                        AutomationProperties.Name="Sign document"
                        Header="Sign"
                        IsClickEnabled="True"
                        IsEnabled="False"
                    >
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE70F;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>
                </StackPanel>
                <!--  Identity  -->
                <StackPanel Spacing="4">
                    <TextBlock
                        Margin="4,0,0,0"
                        AutomationProperties.HeadingLevel="Level2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Identity"
                    />
                    <controls:SettingsCard
                        x:Name="PersonCard"
                        AutomationProperties.AutomationId="PersonCard"
                        AutomationProperties.Name="Card holder identity"
                        Header="Person"
                    >
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon x:Name="PersonIcon" Glyph="&#xE77B;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8"
                        >
                            <HyperlinkButton
                                x:Name="ConnectRemoteReaderButton"
                                AutomationProperties.AutomationId="ConnectRemoteReaderButton"
                                AutomationProperties.HelpText="Pair with mobile device running RefineID remote reader"
                                AutomationProperties.Name="Connect remote reader"
                                Click="ConnectRemoteReader_Click"
                                Content="Connect Remote Reader"
                            />
                            <TextBlock
                                x:Name="HolderText"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="HolderText"
                                AutomationProperties.Name="Card holder name"
                                IsTextSelectionEnabled="True"
                                Visibility="Collapsed"
                            />
                            <!--  The forget action lives on the row it removes,
                                   pinned to the trailing edge. A confirmation
                                   dialog stands in front of it.  -->
                            <Button
                                x:Name="ForgetIdentityButton"
                                Padding="8"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ForgetIdentityButton"
                                AutomationProperties.Name="Forget identity"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="ForgetIdentity_Click"
                                ToolTipService.ToolTip="Forget identity"
                                Visibility="Collapsed"
                            >
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Glyph="&#xE738;"
                                />
                            </Button>
                        </StackPanel>
                    </controls:SettingsCard>
                </StackPanel>

                <TextBlock
                    x:Name="DiagnosticsText"
                    Margin="4,8,0,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="DiagnosticsText"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                />
            </StackPanel>
        </ScrollViewer>

        <Border
            x:Name="BusyOverlay"
            Background="#66000000"
            IsHitTestVisible="True"
            Visibility="Collapsed"
        >
            <ProgressRing
                Width="48"
                Height="48"
                AutomationProperties.AutomationId="BusyRing"
                AutomationProperties.Name="Loading identity card data"
                IsActive="True"
            />
        </Border>
    </Grid>
</Page>
