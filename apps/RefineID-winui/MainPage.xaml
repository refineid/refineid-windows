<Page
    x:Class="RefineID.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d"
>
    <Grid>
        <!--  Hidden until the first card check, so a card that waits for
              its activation opens on its own page with no flash of this
              one.  -->
        <ScrollViewer
            x:Name="ContentRoot"
            VerticalScrollBarVisibility="Auto"
            Visibility="Collapsed"
        >
            <StackPanel
                MaxWidth="920"
                Padding="32,20,32,40"
                HorizontalAlignment="Stretch"
                Spacing="24"
            >
                <InfoBar
                    x:Name="StatusInfoBar"
                    AutomationProperties.AutomationId="StatusInfoBar"
                    IsClosable="True"
                    IsOpen="False"
                />

                <!--  Document  -->
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="DocumentHeading"
                        Margin="4,0,0,0"
                        AutomationProperties.HeadingLevel="Level2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Document"
                    />
                    <controls:SettingsCard
                        x:Name="VerifyCard"
                        x:Uid="VerifyCard"
                        AutomationProperties.AutomationId="VerifyCard"
                        AutomationProperties.HelpText="Verify a signed document using the card"
                        AutomationProperties.Name="Verify document"
                        Click="Verify_Click"
                        Header="Verify"
                        IsClickEnabled="True"
                    >
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE73E;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        x:Name="SignCard"
                        x:Uid="SignCard"
                        AutomationProperties.AutomationId="SignCard"
                        AutomationProperties.HelpText="Sign a document with the card"
                        AutomationProperties.Name="Sign document"
                        Click="Sign_Click"
                        Header="Sign"
                        IsClickEnabled="True"
                        IsEnabled="False"
                    >
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE70F;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>
                </StackPanel>
                <!--  Identity  -->
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="IdentityHeading"
                        Margin="4,0,0,0"
                        AutomationProperties.HeadingLevel="Level2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Identity"
                    />
                    <controls:SettingsCard
                        x:Name="PersonCard"
                        x:Uid="PersonCard"
                        AutomationProperties.AutomationId="PersonCard"
                        AutomationProperties.Name="Card holder identity"
                        Header="Person"
                    >
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon x:Name="PersonIcon" Glyph="&#xE77B;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8"
                        >
                            <HyperlinkButton
                                x:Name="ConnectRemoteReaderButton"
                                x:Uid="ConnectRemoteReaderButton"
                                AutomationProperties.AutomationId="ConnectRemoteReaderButton"
                                AutomationProperties.HelpText="Pair with mobile device running RefineID remote reader"
                                AutomationProperties.Name="Connect remote reader"
                                Click="ConnectRemoteReader_Click"
                                Content="Connect Remote Reader"
                            />
                            <TextBlock
                                x:Name="HolderText"
                                x:Uid="HolderText"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="HolderText"
                                AutomationProperties.Name="Card holder name"
                                IsTextSelectionEnabled="True"
                                Visibility="Collapsed"
                            />
                            <!--  Forgetting is one visible action on the
                                   row while a pairing exists, and the click
                                   forgets at once.  -->
                            <Button
                                x:Name="ForgetIdentityButton"
                                x:Uid="ForgetIdentityButton"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ForgetIdentityButton"
                                AutomationProperties.Name="Forget"
                                Click="ForgetIdentity_Click"
                                ToolTipService.ToolTip="Forget"
                                Visibility="Collapsed"
                            >
                                <!--  Segoe Fluent Icons UserRemove  -->
                                <FontIcon Glyph="&#xF69B;" />
                            </Button>
                        </StackPanel>
                    </controls:SettingsCard>
                </StackPanel>

                <!--  PINs of the card in a local reader: change, reset,
                      activation and NFC access. The phone manages its own
                      card, so the entry exists only while a reader is
                      connected.  -->
                <controls:SettingsCard
                    x:Name="PinsCard"
                    x:Uid="PinsCard"
                    AutomationProperties.AutomationId="PinsCard"
                    AutomationProperties.HelpText="Change or reset the PINs of the card in the reader"
                    AutomationProperties.Name="PINs"
                    Click="Pins_Click"
                    Header="PINs"
                    IsClickEnabled="True"
                    Visibility="Collapsed"
                >
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8D7;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <TextBlock
                    x:Name="DiagnosticsText"
                    Margin="4,8,0,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="DiagnosticsText"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                />
            </StackPanel>
        </ScrollViewer>

        <Border
            x:Name="BusyOverlay"
            Background="#66000000"
            IsHitTestVisible="True"
            Visibility="Collapsed"
        >
            <ProgressRing
                x:Uid="MainPageBusyRing"
                Width="48"
                Height="48"
                AutomationProperties.AutomationId="BusyRing"
                AutomationProperties.Name="Loading identity card data"
                IsActive="True"
            />
        </Border>
    </Grid>
</Page>
