<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  IgnorableNamespaces="uap rescap desktop2">

  <!-- Version is stamped at build by RefineID.csproj. -->
  <Identity
    Name="C3A7F1E2-9B4D-4E60-8A11-5F2C7D9E0B34"
    Publisher="CN=RefineID"
    Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="C3A7F1E2-9B4D-4E60-8A11-5F2C7D9E0B34" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>RefineID</DisplayName>
    <PublisherDisplayName>RefineID</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26226.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="RefineID"
        Description="Finnish citizen certificate card, local or remote"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <!-- The one inbound path the app needs: the phone's mDNS answers to the
       browse, on the shared mDNS port. Declared here, Windows creates the
       rule at install for the package, not for one version's path, so no
       update asks again, and the uninstall removes it. The app listens on
       no TCP port; it only dials out. All profiles, as a home network is
       often classed public. -->
  <Extensions>
    <desktop2:Extension Category="windows.firewallRules">
      <desktop2:FirewallRules Executable="RefineID.exe">
        <desktop2:Rule Direction="in" IPProtocol="UDP" Profile="all" LocalPortMin="5353" LocalPortMax="5353" />
      </desktop2:FirewallRules>
    </desktop2:Extension>
  </Extensions>
</Package>
