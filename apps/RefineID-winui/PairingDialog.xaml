<ContentDialog
    x:Class="RefineID.PairingDialog"
    x:Uid="PairingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Remote Card"
    CloseButtonText="Cancel"
    mc:Ignorable="d"
>
    <StackPanel MinWidth="320" Spacing="16">
        <!--  The code as the phone shows it, three groups of two. A prompt
              shaped like a code stands in for an empty group, and the group
              being typed carries the accent line. One text box, kept
              invisible over the groups, takes the typing, so paste and
              Backspace work as in any field, and a complete code starts the
              pairing at once.  -->
        <Grid HorizontalAlignment="Center">
            <StackPanel
                AutomationProperties.AccessibilityView="Raw"
                Orientation="Horizontal"
                Spacing="12"
            >
                <Border
                    x:Name="Group0Line"
                    MinWidth="52"
                    Padding="8,4"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,2"
                >
                    <TextBlock
                        x:Name="Group0"
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="7K"
                    />
                </Border>
                <Border
                    x:Name="Group1Line"
                    MinWidth="52"
                    Padding="8,4"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,2"
                >
                    <TextBlock
                        x:Name="Group1"
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="X4"
                    />
                </Border>
                <Border
                    x:Name="Group2Line"
                    MinWidth="52"
                    Padding="8,4"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,2"
                >
                    <TextBlock
                        x:Name="Group2"
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="M9"
                    />
                </Border>
            </StackPanel>
            <TextBox
                x:Name="CodeBox"
                x:Uid="CodeBox"
                VerticalAlignment="Stretch"
                AutomationProperties.AutomationId="CodeBox"
                AutomationProperties.Name="Pairing code"
                CharacterCasing="Upper"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                MaxLength="8"
                Opacity="0"
                TextChanged="CodeBox_TextChanged"
            />
        </Grid>

        <TextBlock
            x:Name="StatusText"
            HorizontalAlignment="Center"
            AutomationProperties.AutomationId="StatusText"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="Collapsed"
        />

        <ProgressRing
            x:Name="WaitRing"
            x:Uid="WaitRing"
            Width="28"
            Height="28"
            HorizontalAlignment="Center"
            AutomationProperties.AutomationId="WaitRing"
            AutomationProperties.Name="Pairing"
            IsActive="False"
            Visibility="Collapsed"
        />
    </StackPanel>
</ContentDialog>
