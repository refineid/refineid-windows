<ContentDialog
    x:Class="RefineID.PairingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Remote Card"
    CloseButtonText="Cancel"
    mc:Ignorable="d"
>
    <StackPanel MinWidth="320" Spacing="16">
        <TextBlock
            x:Name="StatusText"
            HorizontalAlignment="Center"
            AutomationProperties.AutomationId="StatusText"
            AutomationProperties.HeadingLevel="Level2"
            Text="Scan QR or enter pairing code on the phone"
            TextAlignment="Center"
            TextWrapping="Wrap"
        />

        <Border
            x:Name="QrFrame"
            Width="248"
            Height="248"
            HorizontalAlignment="Center"
            Background="White"
            CornerRadius="8"
        >
            <Image
                x:Name="QrImage"
                Width="232"
                Height="232"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="QrImage"
                AutomationProperties.Name="Pairing QR code"
            />
        </Border>

        <TextBlock
            x:Name="PairingCodeText"
            HorizontalAlignment="Center"
            AutomationProperties.AutomationId="PairingCodeText"
            AutomationProperties.Name="Pairing code"
            FontSize="24"
            FontWeight="SemiBold"
            CharacterSpacing="120"
            TextAlignment="Center"
        />

        <ProgressRing
            x:Name="WaitRing"
            Width="28"
            Height="28"
            HorizontalAlignment="Center"
            AutomationProperties.AutomationId="WaitRing"
            AutomationProperties.Name="Waiting for remote reader pairing"
            IsActive="True"
        />
    </StackPanel>
</ContentDialog>
