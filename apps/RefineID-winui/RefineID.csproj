<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>RefineID</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embeds the icon in the executable so Explorer, the taskbar, and
         Alt+Tab show it; AppWindow.SetIcon uses the same file at runtime. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'arm64'"
      >win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <!-- The MSIX carries the .NET runtime itself: the Store installs framework
         packages such as the Windows App SDK, but has none for .NET, and a
         packaged app may not download one at run time. -->
    <SelfContained>true</SelfContained>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType Condition="'$(Configuration)' == 'Debug'">None</WindowsPackageType>
    <EnableMsixTooling Condition="'$(Configuration)' == 'Debug'">false</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Strictness: every analyzer at its latest rules, warnings are errors,
         and code style is enforced at build. Generated XAML/interop code is
         skipped by the analyzers' generated-code convention. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- The version is the UTC build instant as CalVer YY.M.D.HHMM, HHMM
         being the time of day as one number (hour * 100 + minute, 0 to
         2359, no leading zero: a package version field is a plain integer).
         The instant is read once so every component comes from the same
         clock reading. All three managed version fields are stamped:
         <Version> alone only sets the informational version, while
         Assembly.GetName().Version (shown in the footer) reads
         AssemblyVersion, which otherwise falls back to the SDK default and
         renders as 0.0.0.0. The package identity carries the same stamp,
         so a later build of the same day installs over an earlier one; a
         Store build (RefineIdStoreBuild=true) carries revision 0 instead,
         which the Store reserves. The Rust build gets the same stamp
         through REFINEID_VERSION. -->
    <RefineIdBuildTicks>$([System.DateTime]::UtcNow.Ticks)</RefineIdBuildTicks>
    <RefineIdBuildYear>$([MSBuild]::Subtract($([System.DateTime]::FromBinary($(RefineIdBuildTicks)).Year), 2000))</RefineIdBuildYear>
    <RefineIdBuildMonth>$([System.DateTime]::FromBinary($(RefineIdBuildTicks)).Month)</RefineIdBuildMonth>
    <RefineIdBuildDay>$([System.DateTime]::FromBinary($(RefineIdBuildTicks)).Day)</RefineIdBuildDay>
    <RefineIdBuildTime>$([MSBuild]::Add($([MSBuild]::Multiply($([System.DateTime]::FromBinary($(RefineIdBuildTicks)).Hour), 100)), $([System.DateTime]::FromBinary($(RefineIdBuildTicks)).Minute)))</RefineIdBuildTime>
    <RefineIdVersion>$(RefineIdBuildYear).$(RefineIdBuildMonth).$(RefineIdBuildDay).$(RefineIdBuildTime)</RefineIdVersion>
    <RefineIdPackageVersion Condition="'$(RefineIdStoreBuild)' != 'true'"
      >$(RefineIdVersion)</RefineIdPackageVersion>
    <RefineIdPackageVersion Condition="'$(RefineIdStoreBuild)' == 'true'"
      >$(RefineIdBuildYear).$(RefineIdBuildMonth).$(RefineIdBuildDay).0</RefineIdPackageVersion>
    <Version>$(RefineIdVersion)</Version>
    <AssemblyVersion>$(RefineIdVersion)</AssemblyVersion>
    <FileVersion>$(RefineIdVersion)</FileVersion>
    <RustCargo Condition="Exists('$(USERPROFILE)\.cargo\bin\cargo.exe')"
      >$(USERPROFILE)\.cargo\bin\cargo.exe</RustCargo>
    <RustCargo Condition="'$(RustCargo)' == ''">cargo</RustCargo>
    <RustProfile Condition="'$(Configuration)' == 'Release'">release</RustProfile>
    <RustProfile Condition="'$(RustProfile)' == ''">debug</RustProfile>
    <RustReleaseArgument Condition="'$(Configuration)' == 'Release'">--release</RustReleaseArgument>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content
      Include="..\..\target\$(RustProfile)\refineid_rapp_ffi.dll"
      Link="refineid_rapp_ffi.dll"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="..\..\target\$(RustProfile)\refineid_settings_ffi.dll"
      Link="refineid_settings_ffi.dll"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.5.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference
      Include="CommunityToolkit.WinUI.Controls.SettingsControls"
      Version="8.2.250402"
    />
  </ItemGroup>

  <!-- A development build reads the Windows Event Log for its Errors
       window; a release build references none of it. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Builds the Rust bridges before the C# build. A machine that
       already has the cdylib next to the workspace target can skip this with
       -p:SkipRustBuild=true. -->
  <Target
    Name="BuildRustRappBridge"
    BeforeTargets="PrepareForBuild"
    Condition="'$(SkipRustBuild)' != 'true'"
  >
    <Exec
      Command="&quot;$(RustCargo)&quot; build -p refineid-rapp-ffi -p refineid-settings-ffi $(RustReleaseArgument)"
      EnvironmentVariables="REFINEID_VERSION=$(RefineIdVersion)"
      WorkingDirectory="$(MSBuildProjectDirectory)\..\.."
    />
  </Target>
  <!-- Stamps the package identity with the build instant. The source manifest
       keeps a placeholder version; the generated manifest in the
       intermediate directory is the one the package is built from. -->
  <Target Name="StampAppxManifestVersion" AfterTargets="_GenerateCurrentProjectAppxManifest">
    <XmlPoke
      XmlInputPath="$(FinalAppxManifestName)"
      Namespaces="&lt;Namespace Prefix='m' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;"
      Query="/m:Package/m:Identity/@Version"
      Value="$(RefineIdPackageVersion)"
    />
  </Target>
  <!-- The package file and its test directory are named after the identity
       version the packaging targets read from the source manifest, which is
       the placeholder. Naming them from the stamp instead gives
       RefineID_YY.M.D.HHMM_<arch>.msix, the version the package carries. -->
  <Target
    Name="StampAppxPackageFileName"
    DependsOnTargets="_ValidatePresenceOfAppxManifestItems"
    BeforeTargets="_ComputeAppxPackageOutput"
  >
    <PropertyGroup>
      <AppxManifestIdentityVersion>$(RefineIdPackageVersion)</AppxManifestIdentityVersion>
    </PropertyGroup>
  </Target>
</Project>
