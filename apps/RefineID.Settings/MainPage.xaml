<Page
    x:Class="RefineID_Settings.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d"
>
    <Grid>
        <ScrollViewer>
            <!-- The content column grows up to its maximum width and stays at the
                 left edge of wider windows. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="920" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="ActionRoot" Padding="32,24,32,48" Spacing="20">
                    <InfoBar
                        x:Name="StatusInfoBar"
                        AutomationProperties.AutomationId="StatusInfoBar"
                        IsClosable="True"
                        IsOpen="False"
                    />

                    <ComboBox
                        x:Name="ReaderComboBox"
                        AutomationProperties.AutomationId="ReaderComboBox"
                        AutomationProperties.Name="Card reader"
                        Header="Card reader"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="No reader"
                        SelectionChanged="ReaderComboBox_SelectionChanged"
                    />

                    <Border
                        x:Name="CardPanel"
                        Padding="20"
                        AutomationProperties.AutomationId="CardPanel"
                        AutomationProperties.Name="Card details"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed"
                    >
                        <Grid ColumnSpacing="20" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock FontWeight="SemiBold" Text="Card holder" />
                            <TextBlock
                                x:Name="PersonText"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="PersonText"
                                AutomationProperties.Name="Card holder"
                                TextWrapping="Wrap"
                            />
                            <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Card model" />
                            <TextBlock
                                x:Name="ModelText"
                                Grid.Row="1"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="ModelText"
                                AutomationProperties.Name="Card model"
                                TextWrapping="Wrap"
                            />
                            <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Card serial" />
                            <TextBlock
                                x:Name="SerialText"
                                Grid.Row="2"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="SerialText"
                                AutomationProperties.Name="Card serial"
                                TextWrapping="Wrap"
                            />
                            <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="PIN1" />
                            <TextBlock
                                x:Name="Pin1StatusText"
                                Grid.Row="3"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="Pin1StatusText"
                                AutomationProperties.Name="PIN1 status"
                            />
                            <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="PIN2" />
                            <TextBlock
                                x:Name="Pin2StatusText"
                                Grid.Row="4"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="Pin2StatusText"
                                AutomationProperties.Name="PIN2 status"
                            />
                            <TextBlock Grid.Row="5" FontWeight="SemiBold" Text="Recovery code" />
                            <TextBlock
                                x:Name="PukStatusText"
                                Grid.Row="5"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="PukStatusText"
                                AutomationProperties.Name="Recovery code status"
                            />
                            <TextBlock Grid.Row="6" FontWeight="SemiBold" Text="Issuance scheme" />
                            <TextBlock
                                x:Name="GenerationText"
                                Grid.Row="6"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="GenerationText"
                                AutomationProperties.Name="Issuance scheme"
                            />
                        </Grid>
                    </Border>

                    <Expander
                        x:Name="NfcExpander"
                        AutomationProperties.AutomationId="NfcExpander"
                        AutomationProperties.Name="Contactless NFC"
                        Header="Contactless NFC"
                    >
                        <StackPanel Padding="0,12,0,4" Spacing="12">
                            <TextBlock
                                Text="Enter the CAN printed on the card."
                                TextWrapping="Wrap"
                            />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox
                                    x:Name="CanBox"
                                    AutomationProperties.AutomationId="CanBox"
                                    AutomationProperties.Name="Card access number (CAN)"
                                    Header="Card access number (CAN)"
                                    MaxLength="6"
                                    PasswordRevealMode="Peek"
                                />
                                <Button
                                    x:Name="EnableNfcButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.AutomationId="EnableNfcButton"
                                    AutomationProperties.Name="Enable NFC access"
                                    Click="EnableNfcButton_Click"
                                    Content="Enable NFC access"
                                />
                            </Grid>
                            <Border
                                x:Name="NfcResultPanel"
                                Padding="12"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Visibility="Collapsed"
                            >
                                <TextBlock
                                    x:Name="NfcResultText"
                                    AutomationProperties.AutomationId="NfcResultText"
                                    TextWrapping="Wrap"
                                />
                            </Border>
                        </StackPanel>
                    </Expander>

                    <StackPanel
                        x:Name="ManagementPanel"
                        IsHitTestVisible="False"
                        Opacity="0.6"
                        Spacing="12"
                    >
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="Card management"
                        />
                        <InfoBar
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Informational"
                            Message="PIN1: login. PIN2: signing."
                        />

                        <Expander
                            x:Name="ChangePinExpander"
                            AutomationProperties.AutomationId="ChangePinExpander"
                            AutomationProperties.Name="Change PIN"
                            Header="Change PIN"
                        >
                            <StackPanel Padding="0,12,0,4" Spacing="10">
                                <ComboBox
                                    x:Name="ChangeSlotBox"
                                    AutomationProperties.AutomationId="ChangeSlotBox"
                                    AutomationProperties.Name="Credential to change"
                                    Header="Credential"
                                    SelectedIndex="0"
                                >
                                    <ComboBoxItem Content="PIN1 - authentication" />
                                    <ComboBoxItem Content="PIN2 - qualified signature" />
                                </ComboBox>
                                <PasswordBox
                                    x:Name="CurrentPinBox"
                                    AutomationProperties.AutomationId="CurrentPinBox"
                                    AutomationProperties.Name="Current PIN"
                                    Header="Current PIN"
                                    MaxLength="12"
                                    PasswordRevealMode="Peek"
                                />
                                <PasswordBox
                                    x:Name="NewPinBox"
                                    AutomationProperties.AutomationId="NewPinBox"
                                    AutomationProperties.Name="New PIN"
                                    Header="New PIN"
                                    MaxLength="12"
                                    PasswordRevealMode="Peek"
                                />
                                <PasswordBox
                                    x:Name="NewPinConfirmationBox"
                                    AutomationProperties.AutomationId="NewPinConfirmationBox"
                                    AutomationProperties.Name="Confirm new PIN"
                                    Header="Confirm new PIN"
                                    MaxLength="12"
                                    PasswordRevealMode="Peek"
                                />
                                <Button
                                    x:Name="ChangePinButton"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="ChangePinButton"
                                    AutomationProperties.Name="Change PIN"
                                    Click="ChangePinButton_Click"
                                    Content="Change PIN"
                                />
                            </StackPanel>
                        </Expander>

                        <Expander
                            x:Name="UnblockPinExpander"
                            AutomationProperties.AutomationId="UnblockPinExpander"
                            AutomationProperties.Name="Reset PIN (PUK)"
                            Header="Reset PIN (PUK)"
                        >
                            <StackPanel Padding="0,12,0,4" Spacing="10">
                                <TextBlock
                                    Text="Wrong code uses one recovery attempt."
                                    TextWrapping="Wrap"
                                />
                                <ComboBox
                                    x:Name="UnblockSlotBox"
                                    AutomationProperties.AutomationId="UnblockSlotBox"
                                    AutomationProperties.Name="Credential to reset"
                                    Header="Credential"
                                    SelectedIndex="1"
                                >
                                    <ComboBoxItem Content="PIN1 - authentication" />
                                    <ComboBoxItem Content="PIN2 - qualified signature" />
                                </ComboBox>
                                <PasswordBox
                                    x:Name="PukBox"
                                    AutomationProperties.AutomationId="PukBox"
                                    AutomationProperties.Name="Recovery code (PUK)"
                                    Header="Recovery code (PUK)"
                                    MaxLength="8"
                                    PasswordRevealMode="Peek"
                                />
                                <PasswordBox
                                    x:Name="UnblockNewPinBox"
                                    AutomationProperties.AutomationId="UnblockNewPinBox"
                                    AutomationProperties.Name="New PIN for recovery"
                                    Header="New PIN"
                                    MaxLength="12"
                                    PasswordRevealMode="Peek"
                                />
                                <PasswordBox
                                    x:Name="UnblockConfirmationBox"
                                    AutomationProperties.AutomationId="UnblockConfirmationBox"
                                    AutomationProperties.Name="Confirm new PIN for recovery"
                                    Header="Confirm new PIN"
                                    MaxLength="12"
                                    PasswordRevealMode="Peek"
                                />
                                <Button
                                    x:Name="ResetPinButton"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="ResetPinButton"
                                    AutomationProperties.Name="Reset PIN"
                                    Click="UnblockPinButton_Click"
                                    Content="Reset PIN"
                                />
                            </StackPanel>
                        </Expander>

                        <Expander
                            x:Name="ActivationExpander"
                            AutomationProperties.AutomationId="ActivationExpander"
                            AutomationProperties.Name="Activate a new card"
                            Header="Activate a new card"
                        >
                            <StackPanel Padding="0,12,0,4" Spacing="10">
                                <TextBlock
                                    x:Name="ActivationHintText"
                                    AutomationProperties.AutomationId="ActivationHintText"
                                    TextWrapping="Wrap"
                                />
                                <PasswordBox
                                    x:Name="ActivationCodeBox"
                                    AutomationProperties.AutomationId="ActivationCodeBox"
                                    AutomationProperties.Name="Activation code"
                                    Header="Activation code"
                                    MaxLength="8"
                                    PasswordRevealMode="Peek"
                                />
                                <PasswordBox
                                    x:Name="ActivationPin1Box"
                                    AutomationProperties.AutomationId="ActivationPin1Box"
                                    AutomationProperties.Name="New PIN1"
                                    Header="New PIN1"
                                    MaxLength="12"
                                    PasswordRevealMode="Peek"
                                />
                                <PasswordBox
                                    x:Name="ActivationPin1ConfirmationBox"
                                    AutomationProperties.AutomationId="ActivationPin1ConfirmationBox"
                                    AutomationProperties.Name="Confirm new PIN1"
                                    Header="Confirm new PIN1"
                                    MaxLength="12"
                                    PasswordRevealMode="Peek"
                                />
                                <PasswordBox
                                    x:Name="ActivationPin2Box"
                                    AutomationProperties.AutomationId="ActivationPin2Box"
                                    AutomationProperties.Name="New PIN2"
                                    Header="New PIN2"
                                    MaxLength="12"
                                    PasswordRevealMode="Peek"
                                />
                                <PasswordBox
                                    x:Name="ActivationPin2ConfirmationBox"
                                    AutomationProperties.AutomationId="ActivationPin2ConfirmationBox"
                                    AutomationProperties.Name="Confirm new PIN2"
                                    Header="Confirm new PIN2"
                                    MaxLength="12"
                                    PasswordRevealMode="Peek"
                                />
                                <Button
                                    x:Name="ActivateButton"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="ActivateButton"
                                    AutomationProperties.Name="Activate card"
                                    Click="ActivateButton_Click"
                                    Content="Activate card"
                                />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border x:Name="BusyOverlay" Background="#66000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing
                    Width="48"
                    Height="48"
                    AutomationProperties.AutomationId="BusyRing"
                    AutomationProperties.Name="Working with the card"
                    IsActive="True"
                />
                <TextBlock Foreground="White" Text="Working with the card..." />
            </StackPanel>
        </Border>
    </Grid>
</Page>
